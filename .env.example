# Copy to .env and fill in what you use. .env is ignored by Git; this template is not.
# Settings are described in docs/configuration.md.

# --- Models (only the providers you select with --llm) ---
DEEPSEEK_API_KEY=
# KIMI_API_KEY=
# GLM_API_KEY=
# BAILIAN_API_KEY=
# FABENCH_OPENROUTER_API_KEY=
# CUSTOM_API_KEY=
# CUSTOM_BASE_URL=

# --- Frozen setting ---
# Frozen index used when --frozen-corpus-file is not given.
FABENCH_CORPUS_DB=/path/to/ccnews-before-20260701-v1.db

# --- Web settings (web-filter and both) ---
SERPER_API_KEY=
JINA_API_KEY=
# Python with vendor/retrieval-infra/requirements.txt, for page dating and extraction.
HTMLDATE_PYTHON=/path/to/.venv/bin/python

# --- backsearch setting only ---
# OPENREWARD_API_KEY=

# --- Optional installation settings (or put them in the FABENCH_PATHS_CONFIG file) ---
# FABENCH_PATHS_CONFIG=/absolute/path/to/fabench/config/paths.local.json
# FABENCH_DATA_ROOT=/absolute/path/to/fabench-data
# FABENCH_HTTP_USER_AGENT="FABench/0.1 (research; contact: ...)"
